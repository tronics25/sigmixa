        },
        {
          "id": "sig-power-utilization",
          "name": "Power Utilization",
          "unit": "%",
          "operation": {
            "type": "expression",
            "expression": "clamp(abs([Mechanical Power]) / 0.8, 0, 100)"
          }
        }
