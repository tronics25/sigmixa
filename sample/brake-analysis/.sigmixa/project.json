{
  "schemaVersion": 4,
  "frames": [
    {
      "id": "ff-300",
      "name": "Brake and Wheel Speed",
      "frameLength": 8,
      "origin": {
        "type": "manual"
      },
      "signals": [
        {
          "id": "sig-brake-pressure",
          "name": "Brake Pressure",
          "unit": "bar",
          "byteOffset": 0,
          "bitOffset": 0,
          "lengthBits": 16,
          "signedness": "unsigned",
          "byteOrder": "little",
          "conversion": {
            "type": "scale-offset",
            "lsb": 0.1,
            "lsbText": "0.1",
            "offset": 0
          }
        },
        {
          "id": "sig-pedal",
          "name": "Brake Pedal Position",
          "unit": "%",
          "byteOffset": 2,
          "bitOffset": 0,
          "lengthBits": 16,
          "signedness": "unsigned",
          "byteOrder": "little",
          "conversion": {
            "type": "scale-offset",
            "lsb": 0.1,
            "lsbText": "0.1",
            "offset": 0
          }
        },
        {
          "id": "sig-wheel-speed-fl",
          "name": "Front Left Wheel Speed",
          "unit": "km/h",
          "byteOffset": 4,
          "bitOffset": 0,
          "lengthBits": 16,
          "signedness": "unsigned",
          "byteOrder": "little",
          "conversion": {
            "type": "scale-offset",
            "lsb": 0.01,
            "lsbText": "0.01",
            "offset": 0
          }
        },
        {
          "id": "sig-wheel-speed-fr",
          "name": "Front Right Wheel Speed",
          "unit": "km/h",
          "byteOffset": 6,
          "bitOffset": 0,
          "lengthBits": 16,
          "signedness": "unsigned",
          "byteOrder": "little",
          "conversion": {
            "type": "scale-offset",
            "lsb": 0.01,
            "lsbText": "0.01",
            "offset": 0
          }
        }
      ],
      "derivedSignals": [
        {
          "id": "sig-pedal-pressure-ratio",
          "name": "Pedal to Pressure Ratio",
          "unit": "bar/%",
          "operation": {
            "type": "expression",
            "expression": "[Brake Pressure] / max([Brake Pedal Position], 1)"
          }
        }
      ],
      "canId": "300"
    }
  ],
  "plugins": [],
