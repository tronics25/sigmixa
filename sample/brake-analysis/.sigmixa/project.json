            "chartConnectGaps": true,
            "chartAxisRange": {
              "mode": "visible",
              "includeZero": false
            },
            "chartGroupLayout": [
              [
                "family:pressure",
                "family:speed"
              ]
            ],
            "chartSignalGrouping": "frame"
          }
        },
        {
          "id": "view-pedal",
