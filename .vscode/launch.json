{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run SigMixa (画面確認・デバッグなし)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extension=github.copilot-chat",
        "--disable-extension=openai.chatgpt",
        "--disable-extension=fill-labs.dependi",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/work/debug-sample"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "SigMixa: debug",
      "noDebug": true
    },
    {
      "name": "Run SigMixa (F5)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--disable-extension=github.copilot-chat",
        "--disable-extension=openai.chatgpt",
        "--disable-extension=fill-labs.dependi",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "${workspaceFolder}/work/debug-sample"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "SigMixa: debug"
    }
  ]
}
