{
  "name": "sigmixa",
  "displayName": "SigMixa — CAN Log Analyzer",
  "description": "%sigmixa.description%",
  "version": "2.1.0",
  "publisher": "tronics25",
  "license": "MIT",
  "private": true,
  "icon": "media/sigmixa-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tronics25/sigmixa.git"
  },
  "bugs": {
    "url": "https://github.com/tronics25/sigmixa/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "CAN",
    "CAN bus",
    "CAN FD",
    "DBC",
    "ASC",
    "BLF",
    "CANalyzer",
    "log viewer",
    "CAN trace",
    "decoder",
    "automotive",
    "telemetry",
    "signal plot",
    "time series",
    "trajectory",
    "multiplexing",
    "visualization",
    "data analysis"
  ],
  "galleryBanner": {
    "color": "#1B2A4A",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://vsmarketplacebadges.dev/version-short/tronics25.sigmixa.svg",
      "href": "https://marketplace.visualstudio.com/items?itemName=tronics25.sigmixa",
      "description": "VS Code Marketplace version"
    },
    {
      "url": "https://img.shields.io/github/license/tronics25/sigmixa",
      "href": "https://github.com/tronics25/sigmixa/blob/main/LICENSE",
      "description": "MIT License"
    }
  ],
  "activationEvents": [
    "onCustomEditor:sigmixa.rawLog",
    "onView:sigmixa.frames",
    "onView:sigmixa.plugins",
    "onView:sigmixa.analysisGroups"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "sigmixa.rawLog",
        "displayName": "SigMixa",
        "selector": [
          {
            "filenamePattern": "*.asc"
          },
          {
            "filenamePattern": "*.blf"
          },
          {
            "filenamePattern": "sigmixa:/**"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sigmixa",
          "title": "SigMixa",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "sigmixa": [
        {
          "id": "sigmixa.analysisGroups",
          "name": "%sigmixa.views.analysisGroups%"
        },
        {
          "id": "sigmixa.frames",
          "name": "%sigmixa.views.frames%"
        },
        {
          "id": "sigmixa.plugins",
          "name": "%sigmixa.views.plugins%"
        }
      ]
    },
    "commands": [
      {
        "command": "sigmixa.openLog",
        "title": "%sigmixa.command.openLog%",
        "category": "SigMixa",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sigmixa.openLogInWorkspace",
        "title": "%sigmixa.command.openLog%",
        "category": "SigMixa",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sigmixa.addFrame",
        "title": "%sigmixa.command.addFrame%",
        "category": "SigMixa",
        "icon": "$(add)"
      },
      {
        "command": "sigmixa.addFrameFromTitle",
        "title": "%sigmixa.command.addFrame%",
        "category": "SigMixa",
        "icon": "$(add)"
      },
      {
        "command": "sigmixa.openClip",
        "title": "%sigmixa.command.openClip%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.openClipSource",
        "title": "%sigmixa.command.openClipSource%",
        "category": "SigMixa",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sigmixa.compareClips",
        "title": "%sigmixa.command.compareClips%",
        "category": "SigMixa",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "sigmixa.deleteClip",
        "title": "%sigmixa.command.deleteClip%",
        "category": "SigMixa",
        "icon": "$(trash)"
      },
      {
        "command": "sigmixa.importDbc",
        "title": "%sigmixa.command.importDbc%",
        "category": "SigMixa",
        "icon": "$(database)"
      },
      {
        "command": "sigmixa.exportDbc",
        "title": "%sigmixa.command.exportDbc%",
        "category": "SigMixa",
        "icon": {
          "light": "media/icons/export-light.svg",
          "dark": "media/icons/export-dark.svg"
        }
      },
      {
        "command": "sigmixa.exportAllDbc",
        "title": "%sigmixa.command.exportDbc%",
        "category": "SigMixa",
        "icon": {
          "light": "media/icons/export-light.svg",
          "dark": "media/icons/export-dark.svg"
        }
      },
      {
        "command": "sigmixa.openFrame",
        "title": "%sigmixa.command.openFrame%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.deleteFrame",
        "title": "%sigmixa.command.deleteFrame%",
        "category": "SigMixa",
        "icon": "$(trash)"
      },
      {
        "command": "sigmixa.renameFrame",
        "title": "%sigmixa.command.renameFrame%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.unregisterPlugins",
        "title": "%sigmixa.command.unregisterPlugins%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.addPlugin",
        "title": "%sigmixa.command.addPlugin%",
        "category": "SigMixa",
        "icon": "$(add)"
      },
      {
        "command": "sigmixa.openPlugin",
        "title": "%sigmixa.command.openPlugin%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.refresh",
        "title": "%sigmixa.command.refresh%",
        "category": "SigMixa",
        "icon": "$(refresh)"
      },
      {
        "command": "sigmixa.addGroup",
        "title": "%sigmixa.command.addGroup%",
        "category": "SigMixa",
        "icon": "$(add)"
      },
      {
        "command": "sigmixa.addGroupInWorkspace",
        "title": "%sigmixa.command.addGroup%",
        "category": "SigMixa",
        "icon": "$(add)"
      },
      {
        "command": "sigmixa.openGroupDefinitions",
        "title": "%sigmixa.command.openGroupDefinitions%",
        "category": "SigMixa",
        "icon": "$(layers)"
      },
      {
        "command": "sigmixa.makeFolderGroup",
        "title": "%sigmixa.command.makeFolderGroup%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.revealInOS",
        "title": "%sigmixa.command.revealInOS%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.revealInOSWindows",
        "title": "%sigmixa.command.revealInOSWindows%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.revealInOSLinux",
        "title": "%sigmixa.command.revealInOSLinux%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.removeAddedLog",
        "title": "%sigmixa.command.removeAddedLog%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.openItem",
        "title": "%sigmixa.command.openItem%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.renameItem",
        "title": "%sigmixa.command.renameItem%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.trashLog",
        "title": "%sigmixa.command.trashLog%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.trashLogWindows",
        "title": "%sigmixa.command.trashLogWindows%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.deleteItem",
        "title": "%sigmixa.command.deleteItem%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.copyPath",
        "title": "%sigmixa.command.copyPath%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.dissolveGroup",
        "title": "%sigmixa.command.dissolveGroup%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.transferLogs",
        "title": "%sigmixa.command.transferLogs%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.pasteLogs",
        "title": "%sigmixa.command.pasteLogs%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.editClipRange",
        "title": "%sigmixa.command.editClipRange%",
        "category": "SigMixa"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sigmixa.compareClips",
          "when": "view == sigmixa.analysisGroups && sigmixa.canCompare",
          "group": "navigation"
        },
        {
          "command": "sigmixa.openLogInWorkspace",
          "when": "view == sigmixa.analysisGroups",
          "group": "navigation"
        },
        {
          "command": "sigmixa.addFrameFromTitle",
          "when": "view == sigmixa.frames",
          "group": "navigation"
        },
        {
          "command": "sigmixa.importDbc",
          "when": "view == sigmixa.frames",
          "group": "navigation@2"
        },
        {
          "command": "sigmixa.exportAllDbc",
          "when": "view == sigmixa.frames",
          "group": "navigation@3"
        },
        {
          "command": "sigmixa.addPlugin",
          "when": "view == sigmixa.plugins",
          "group": "navigation"
        },
        {
          "command": "sigmixa.addGroupInWorkspace",
          "when": "view == sigmixa.analysisGroups",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "sigmixa.openClipSource",
          "when": "view == sigmixa.analysisGroups && viewItem == sigmixa.clip",
          "group": "navigation@1"
        },
        {
          "command": "sigmixa.compareClips",
          "when": "view == sigmixa.analysisGroups && listMultiSelection && viewItem =~ /sigmixa\\.(clip|analysisFile|addedFile)/",
          "group": "navigation@2"
        },
        {
          "command": "sigmixa.deleteClip",
          "when": "view == sigmixa.analysisGroups && viewItem == sigmixa.clip",
          "group": "inline"
        },
        {
          "command": "sigmixa.deleteFrame",
          "when": "view == sigmixa.frames && viewItem == sigmixa.manualFrame",
          "group": "inline"
        },
        {
          "command": "sigmixa.exportDbc",
          "when": "view == sigmixa.frames",
          "group": "navigation"
        },
        {
          "command": "sigmixa.openGroupDefinitions",
          "when": "view == sigmixa.analysisGroups && viewItem == sigmixa.analysisGroup",
          "group": "inline"
        },
        {
          "command": "sigmixa.addGroup",
          "when": "view == sigmixa.analysisGroups && viewItem =~ /sigmixa\\.(analysisGroup|folder)/",
          "group": "1_group@1"
        },
        {
          "command": "sigmixa.makeFolderGroup",
          "when": "view == sigmixa.analysisGroups && viewItem == sigmixa.folder",
          "group": "1_group@2"
        },
        {
          "command": "sigmixa.revealInOS",
          "when": "view == sigmixa.analysisGroups && viewItem =~ /sigmixa\\.(analysisGroup|folder|analysisFile|addedFile)/ && isMac",
          "group": "9_reveal"
        },
        {
          "command": "sigmixa.revealInOSWindows",
          "when": "view == sigmixa.analysisGroups && viewItem =~ /sigmixa\\.(analysisGroup|folder|analysisFile|addedFile)/ && isWindows",
          "group": "9_reveal"
        },
        {
          "command": "sigmixa.revealInOSLinux",
          "when": "view == sigmixa.analysisGroups && viewItem =~ /sigmixa\\.(analysisGroup|folder|analysisFile|addedFile)/ && isLinux",
          "group": "9_reveal"
        },
        {
          "command": "sigmixa.removeAddedLog",
          "when": "view == sigmixa.analysisGroups && viewItem == sigmixa.addedFile",
          "group": "7_modification@2"
        },
        {
          "command": "sigmixa.openLog",
          "when": "view == sigmixa.analysisGroups && viewItem =~ /sigmixa\\.(analysisGroup|folder)/",
          "group": "inline"
        },
        {
          "command": "sigmixa.openItem",
          "when": "view == sigmixa.analysisGroups && !listMultiSelection && viewItem =~ /sigmixa\\.(clip|analysisFile|addedFile)/",
          "group": "navigation@0"
        },
        {
          "command": "sigmixa.copyPath",
          "when": "view == sigmixa.analysisGroups && viewItem =~ /sigmixa\\.(analysisFile|addedFile)/",
          "group": "6_copypath"
        },
        {
          "command": "sigmixa.renameItem",
          "when": "view == sigmixa.analysisGroups && !listMultiSelection && viewItem =~ /sigmixa\\.(clip|analysisFile|analysisGroup|folder)/",
          "group": "7_modification@1"
        },
        {
          "command": "sigmixa.trashLog",
          "when": "view == sigmixa.analysisGroups && viewItem == sigmixa.analysisFile && !isWindows",
          "group": "7_modification@2"
        },
        {
          "command": "sigmixa.trashLogWindows",
          "when": "view == sigmixa.analysisGroups && viewItem == sigmixa.analysisFile && isWindows",
          "group": "7_modification@2"
        },
        {
          "command": "sigmixa.deleteClip",
          "when": "view == sigmixa.analysisGroups && !listMultiSelection && viewItem == sigmixa.clip",
          "group": "7_modification@2"
        },
        {
          "command": "sigmixa.dissolveGroup",
          "when": "view == sigmixa.analysisGroups && viewItem == sigmixa.analysisGroup",
          "group": "7_modification@2"
        },
        {
          "command": "sigmixa.transferLogs",
          "when": "view == sigmixa.analysisGroups && viewItem =~ /sigmixa\\.(analysisFile|addedFile)/",
          "group": "5_transfer"
        },
        {
          "command": "sigmixa.editClipRange",
          "when": "view == sigmixa.analysisGroups && !listMultiSelection && viewItem == sigmixa.clip",
          "group": "7_modification@1"
        },
        {
          "command": "sigmixa.pasteLogs",
          "when": "view == sigmixa.analysisGroups && !listMultiSelection && viewItem =~ /sigmixa\\.(analysisGroup|folder)/",
          "group": "5_transfer"
        },
        {
          "command": "sigmixa.renameFrame",
          "when": "view == sigmixa.frames && viewItem == sigmixa.manualFrame && !listMultiSelection",
          "group": "2_edit@1"
        },
        {
          "command": "sigmixa.deleteFrame",
          "when": "view == sigmixa.frames && viewItem == sigmixa.manualFrame",
          "group": "2_edit@2"
        },
        {
          "command": "sigmixa.unregisterPlugins",
          "when": "view == sigmixa.plugins && viewItem == sigmixa.plugin",
          "group": "2_edit@1"
        }
      ],
      "explorer/context": [
        {
          "command": "sigmixa.makeFolderGroup",
          "when": "explorerResourceIsFolder",
          "group": "7_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "sigmixa.makeFolderGroup",
          "when": "false"
        },
        {
          "command": "sigmixa.revealInOS",
          "when": "false"
        },
        {
          "command": "sigmixa.revealInOSWindows",
          "when": "false"
        },
        {
          "command": "sigmixa.revealInOSLinux",
          "when": "false"
        },
        {
          "command": "sigmixa.removeAddedLog",
          "when": "false"
        },
        {
          "command": "sigmixa.openItem",
          "when": "false"
        },
        {
          "command": "sigmixa.renameItem",
          "when": "false"
        },
        {
          "command": "sigmixa.trashLog",
          "when": "false"
        },
        {
          "command": "sigmixa.trashLogWindows",
          "when": "false"
        },
        {
          "command": "sigmixa.deleteItem",
          "when": "false"
        },
        {
          "command": "sigmixa.copyPath",
          "when": "false"
        },
        {
          "command": "sigmixa.dissolveGroup",
          "when": "false"
        },
        {
          "command": "sigmixa.transferLogs",
          "when": "false"
        },
        {
          "command": "sigmixa.pasteLogs",
          "when": "false"
        },
        {
          "command": "sigmixa.editClipRange",
          "when": "false"
        },
        {
          "command": "sigmixa.openLogInWorkspace",
          "when": "false"
        },
        {
          "command": "sigmixa.addGroupInWorkspace",
          "when": "false"
        },
        {
          "command": "sigmixa.addFrameFromTitle",
          "when": "false"
        },
        {
          "command": "sigmixa.exportAllDbc",
          "when": "false"
        },
        {
          "command": "sigmixa.renameFrame",
          "when": "false"
        },
        {
          "command": "sigmixa.unregisterPlugins",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sigmixa.renameItem",
        "key": "f2",
        "when": "focusedView == sigmixa.analysisGroups"
      },
      {
        "command": "sigmixa.deleteItem",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == sigmixa.analysisGroups"
      },
      {
        "command": "sigmixa.pasteLogs",
        "key": "ctrl+v",
        "mac": "cmd+v",
        "when": "focusedView == sigmixa.analysisGroups"
      },
      {
        "command": "sigmixa.renameFrame",
        "key": "f2",
        "when": "focusedView == sigmixa.frames"
      },
      {
        "command": "sigmixa.deleteFrame",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == sigmixa.frames"
      },
      {
        "command": "sigmixa.unregisterPlugins",
        "key": "delete",
        "mac": "cmd+backspace",
        "when": "focusedView == sigmixa.plugins"
      }
    ]
  },
  "scripts": {
    "sample:generate": "node scripts/generate-basic-log.mjs && node scripts/add-plugin-diagnostic.mjs && node scripts/generate-reference-signals.mjs && node scripts/add-trajectory-data.mjs && node scripts/add-2.0-coverage.mjs && node scripts/generate-basic-blf.mjs && node scripts/generate-sample-project.mjs && node scripts/generate-parking-sample.mjs && node scripts/generate-group-samples.mjs",
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "package:vsix": "npm run verify && npx --offline @vscode/vsce package --no-dependencies --out outputs/sigmixa-${npm_package_version}.vsix",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit -p ./",
    "check-boundaries": "node scripts/check-boundaries.mjs",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run check-boundaries && npm run check-types && npm test && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  }
}
