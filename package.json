{
  "name": "sigmixa",
  "displayName": "SigMixa — CAN Log Analyzer",
  "description": "%sigmixa.description%",
  "version": "1.0.1",
  "publisher": "tronics25",
  "license": "MIT",
  "private": true,
  "icon": "media/sigmixa-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tronics25/sigmixa.git"
  },
  "bugs": {
    "url": "https://github.com/tronics25/sigmixa/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "CAN",
    "CAN bus",
    "CAN FD",
    "DBC",
    "ASC",
    "BLF",
    "CANalyzer",
    "log viewer",
    "CAN trace",
    "decoder",
    "automotive",
    "telemetry",
    "signal plot",
    "time series",
    "trajectory",
    "multiplexing",
    "visualization",
    "data analysis"
  ],
  "galleryBanner": {
    "color": "#1B2A4A",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://vsmarketplacebadges.dev/version-short/tronics25.sigmixa.svg",
      "href": "https://marketplace.visualstudio.com/items?itemName=tronics25.sigmixa",
      "description": "VS Code Marketplace version"
    },
    {
      "url": "https://img.shields.io/github/license/tronics25/sigmixa",
      "href": "https://github.com/tronics25/sigmixa/blob/main/LICENSE",
      "description": "MIT License"
    }
  ],
  "activationEvents": [
    "onCustomEditor:sigmixa.rawLog",
    "onView:sigmixa.logFiles",
    "onView:sigmixa.clips",
    "onView:sigmixa.frames",
    "onView:sigmixa.plugins"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "sigmixa.rawLog",
        "displayName": "SigMixa",
        "selector": [
          {
            "filenamePattern": "*.asc"
          },
          {
            "filenamePattern": "*.blf"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sigmixa",
          "title": "SigMixa",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "sigmixa": [
        {
          "id": "sigmixa.logFiles",
          "name": "%sigmixa.views.logFiles%"
        },
        {
          "id": "sigmixa.clips",
          "name": "%sigmixa.views.clips%"
        },
        {
          "id": "sigmixa.frames",
          "name": "%sigmixa.views.frames%"
        },
        {
          "id": "sigmixa.plugins",
          "name": "%sigmixa.views.plugins%"
        }
      ]
    },
    "commands": [
      {
        "command": "sigmixa.openLog",
        "title": "%sigmixa.command.openLog%",
        "category": "SigMixa",
        "icon": "$(folder-opened)"
      },
      {
        "command": "sigmixa.addFrame",
        "title": "%sigmixa.command.addFrame%",
        "category": "SigMixa",
        "icon": "$(add)"
      },
      {
        "command": "sigmixa.openClip",
        "title": "%sigmixa.command.openClip%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.openClipSource",
        "title": "%sigmixa.command.openClipSource%",
        "category": "SigMixa",
        "icon": "$(go-to-file)"
      },
      {
        "command": "sigmixa.compareClips",
        "title": "%sigmixa.command.compareClips%",
        "category": "SigMixa",
        "icon": "$(graph-line)"
      },
      {
        "command": "sigmixa.deleteClip",
        "title": "%sigmixa.command.deleteClip%",
        "category": "SigMixa",
        "icon": "$(trash)"
      },
      {
        "command": "sigmixa.importDbc",
        "title": "%sigmixa.command.importDbc%",
        "category": "SigMixa",
        "icon": "$(database)"
      },
      {
        "command": "sigmixa.exportDbc",
        "title": "%sigmixa.command.exportDbc%",
        "category": "SigMixa",
        "icon": "$(export)"
      },
      {
        "command": "sigmixa.openFrame",
        "title": "%sigmixa.command.openFrame%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.deleteFrame",
        "title": "%sigmixa.command.deleteFrame%",
        "category": "SigMixa",
        "icon": "$(trash)"
      },
      {
        "command": "sigmixa.addPlugin",
        "title": "%sigmixa.command.addPlugin%",
        "category": "SigMixa",
        "icon": "$(add)"
      },
      {
        "command": "sigmixa.openPlugin",
        "title": "%sigmixa.command.openPlugin%",
        "category": "SigMixa"
      },
      {
        "command": "sigmixa.refresh",
        "title": "%sigmixa.command.refresh%",
        "category": "SigMixa",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sigmixa.compareClips",
          "when": "view == sigmixa.clips",
          "group": "navigation"
        },
        {
          "command": "sigmixa.openLog",
          "when": "view == sigmixa.logFiles",
          "group": "navigation"
        },
        {
          "command": "sigmixa.addFrame",
          "when": "view == sigmixa.frames",
          "group": "navigation"
        },
        {
          "command": "sigmixa.importDbc",
          "when": "view == sigmixa.frames",
          "group": "navigation@2"
        },
        {
          "command": "sigmixa.exportDbc",
          "when": "view == sigmixa.frames",
          "group": "navigation@3"
        },
        {
          "command": "sigmixa.addPlugin",
          "when": "view == sigmixa.plugins",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "sigmixa.openClipSource",
          "when": "view == sigmixa.clips",
          "group": "navigation@1"
        },
        {
          "command": "sigmixa.compareClips",
          "when": "view == sigmixa.clips && viewItem == sigmixa.clip",
          "group": "navigation@2"
        },
        {
          "command": "sigmixa.deleteClip",
          "when": "view == sigmixa.clips",
          "group": "inline"
        },
        {
          "command": "sigmixa.deleteFrame",
          "when": "view == sigmixa.frames && viewItem == sigmixa.manualFrame",
          "group": "inline"
        },
        {
          "command": "sigmixa.exportDbc",
          "when": "view == sigmixa.frames",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "sample:generate": "node scripts/generate-base-showcase.mjs && node scripts/add-plugin-diagnostic.mjs && node scripts/generate-reference-signals.mjs && node scripts/add-trajectory-data.mjs && node scripts/generate-showcase-blf.mjs && node scripts/generate-sample-project.mjs",
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "package:vsix": "npm run verify && npx --offline @vscode/vsce package --no-dependencies --out outputs/sigmixa-${npm_package_version}.vsix",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit -p ./",
    "check-boundaries": "node scripts/check-boundaries.mjs",
    "test": "node scripts/run-tests.mjs",
    "verify": "npm run check-boundaries && npm run check-types && npm test && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.46-24"
  }
}
